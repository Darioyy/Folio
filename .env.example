# ============================================
# Folio 生产环境配置模板
# 复制为 .env 并填入真实值
# ============================================

# Flask密钥（必须修改为强随机值）
# 生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-here

# ============================================
# MySQL数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=your-strong-mysql-root-password
MYSQL_DATABASE=folio
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=folio_user
MYSQL_PASSWORD=your-strong-mysql-password

# Flask 环境
FLASK_ENV=production

# CORS 允许来源（改为你的服务器 IP 或域名）
# 多个用逗号分隔
CORS_ORIGINS=http://your-server-ip
