# ============================================
# 生产环境配置模板
# 部署时复制为 .env 并修改对应值
# ============================================

# Flask密钥 - 请修改为随机字符串
SECRET_KEY=change-this-to-random-string-in-production

# MySQL数据库配置
# 如果MySQL在Docker中运行，MYSQL_HOST可能需要使用Docker内部地址
MYSQL_HOST=172.17.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_web_dev_user
MYSQL_PASSWORD=your-database-password-here
MYSQL_DATABASE=ai_web_dev

# Flask运行环境
FLASK_ENV=production
DEBUG=False

# 文件上传配置
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000  # 500MB
